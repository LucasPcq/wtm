-- github.com/LucasPcq/wtm/internal/surface/cli/aliased/cmd.go --
package aliased // want `cmd.go reads the interactive gate but registers no --yes`

import (
	sh "github.com/LucasPcq/wtm/internal/surface/cli/shared"
	cb "github.com/spf13/cobra"
)

func newCmd() *cb.Command { return &cb.Command{} }

func run() bool { return sh.Interactive() }
-- github.com/LucasPcq/wtm/internal/surface/cli/field/cmd.go --
package field

import (
	"github.com/LucasPcq/wtm/internal/surface/cli/shared"
	"github.com/spf13/cobra"
)

func newCmd() *cobra.Command { return &cobra.Command{} }

func run(interactive bool) bool {
	return shared.Prompter(shared.PrompterParams{Interactive: interactive})
}
-- github.com/LucasPcq/wtm/internal/surface/cli/helper/helper.go --
package helper

import "github.com/LucasPcq/wtm/internal/surface/cli/shared"

func Ask() bool { return shared.Interactive() }
