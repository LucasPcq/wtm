)

var _, _ = dispatch.Run, clean.Command
-- github.com/LucasPcq/wtm/internal/command/create/create.go --
package create

import (
	"context"

	"github.com/LucasPcq/wtm/internal/surface/tui" // want `command/create must not import "github.com/LucasPcq/wtm/internal/surface/tui"`
)

var _ = tui.Draw

func observe(ctx context.Context) error { return ctx.Err() }

func validate() error {
	return observe(context.Background()) // want `context\.Background in command/`
}

func skip() error {
	return observe(context.TODO()) // want `context\.TODO in command/`
}
