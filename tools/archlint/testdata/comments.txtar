-- github.com/LucasPcq/wtm/internal/rules/runenv/runenv.go --
// Package runenv decides a worktree's environment.
package runenv

func Offset(ordinal int) int {
	// An ordinal is a hundred ports wide: a job never reaches the next
	// worktree's range.
	return ordinal * 100
}
-- github.com/LucasPcq/wtm/internal/service/github/github.go --
// Package github reads pull requests,
// on the commands still on flow/.
package github

// token is out of the engine: the rule extends with each migration.
func token() string { return "" }

var _ = token
-- github.com/LucasPcq/wtm/internal/rules/rules.go --
package rules

// clamp is at the root of rules/, which only shrinks: not the engine's.
