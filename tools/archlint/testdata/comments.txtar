-- github.com/LucasPcq/wtm/internal/service/hooks/hooks.go --
// Package hooks runs a worktree's hooks.
package hooks

import "strings"

// Run runs the hooks of a phase in order.
func Run(cmds []string) []string {
	var ran []string
	for _, cmd := range cmds {
		// A blank hook is a line the user left, not a failure.
		if trimmed(cmd) == "" {
			continue
		}
		ran = append(ran, cmd)
	}
	return ran
}

// trimmed is the command without its spaces. // want `doc comment on the unexported trimmed`
func trimmed(cmd string) string { return strings.TrimSpace(cmd) }

//go:noinline
func blank(cmd string) bool { return trimmed(cmd) == "" }

// grace is how long a hook gets. // want `doc comment on the unexported grace`
const grace = 3

// The limits of a phase. // want `doc comment on the unexported limit`
const (
	limit   = 10
	ceiling = 20
)

// Defaults of a phase, read by its callers.
const (
	Limit   = limit
	quiet   = false
	Ceiling = ceiling
)

// sink is where a hook writes. // want `doc comment on the unexported sink`
type sink struct{ lines []string }

type (
	// beat is a hook's start or end. // want `doc comment on the unexported beat`
	beat struct{ started bool }

	// Beat is what a surface draws.
	Beat = beat
)

var _ = blank
var _ = grace
var _ sink
-- github.com/LucasPcq/wtm/internal/infra/git/git.go --
// Package git is the one way the engine reaches git.
package git

func Head() string { return "main" }
-- github.com/LucasPcq/wtm/internal/infra/git/head_test.go --
//go:build !windows

package git

import "testing"

// A detached HEAD reads as no branch.
func TestHead(t *testing.T) {
	// The fake is on main from its seed.
	if Head() != "main" {
		t.Fail()
	}
}

// helper is a test helper. // want `doc comment on the unexported helper`
func helper() string { return Head() }

// --- detached --- // want `section banner in a test file`

func TestDetached(t *testing.T) {
	_ = helper()
}

func TestRuled(t *testing.T) {
	// ======== // want `section banner in a test file`
	_ = helper()
}
