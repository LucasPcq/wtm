-- github.com/LucasPcq/wtm/next/internal/domain/env/env_test.go --
package env

import "testing"

type refusal struct {
	name string
	code int
}

var refusals = []refusal{
	{"missing branch", 1}, // want `subtest name "missing branch" has a space`
	{"unknown_ref", 2},
}

func TestLiteral(t *testing.T) {
	t.Run("a sentence name", func(t *testing.T) {}) // want `subtest name "a sentence name" has a space`
	t.Run("identifier_name", func(t *testing.T) {})
	t.Run("half "+"built", func(t *testing.T) {}) // want `subtest name "half " has a space`
}

func TestKeyedTable(t *testing.T) {
	cases := []struct {
		name string
		in   string
	}{
		{name: "an empty value", in: ""}, // want `subtest name "an empty value" has a space`
		{name: "empty_value", in: "a b"},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {})
	}
}

func TestPositionalTable(t *testing.T) {
	cases := []struct {
		in, name string
	}{
		{"a b", "plain pair"}, // want `subtest name "plain pair" has a space`
		{"a b", "plain_pair"},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {})
	}
}

func TestMapTable(t *testing.T) {
	for name, want := range map[string]string{
		"sorted and compacted": "a b", // want `subtest name "sorted and compacted" has a space`
		"none":                 "a b",
	} {
		t.Run(name, func(t *testing.T) { _ = want })
	}
}

func TestValues(t *testing.T) {
	for _, value := range []string{`say "hi"`, "plain"} { // want `subtest name "say \\"hi\\"" has a space`
		t.Run(value, func(t *testing.T) {})
	}
}

func TestNamedTable(t *testing.T) {
	for _, impl := range []struct{ name string }{{"real"}, {"fake"}} {
		for _, r := range refusals {
			t.Run(impl.name+": "+r.name, func(t *testing.T) {}) // want `subtest name ": " has a space`
		}
	}
}

func BenchmarkStyle(b *testing.B) {
	b.Run("per op", func(b *testing.B) {}) // want `subtest name "per op" has a space`
}

func TestTwoLoops(t *testing.T) {
	for _, tc := range []struct{ in string }{{in: "first loop input"}} {
		_ = tc
	}
	for _, tc := range []struct{ desc string }{{desc: "second loop desc"}} { // want `subtest name "second loop desc" has a space`
		t.Run(tc.desc, func(t *testing.T) {})
	}
}

func TestTwoLoopsInverse(t *testing.T) {
	for _, tc := range []struct{ desc string }{{desc: "not a subtest"}} {
		_ = tc
	}
	for _, tc := range []struct{ desc string }{{desc: "second_loop"}} {
		t.Run(tc.desc, func(t *testing.T) {})
	}
}

func TestNested(t *testing.T) {
	for _, outer := range []string{"outer_ok"} {
		for _, inner := range []string{"inner one"} { // want `subtest name "inner one" has a space`
			t.Run(outer+"_"+inner, func(t *testing.T) {})
		}
	}
}

func TestLocalName(t *testing.T) {
	name := "a local name"           // want `subtest name "a local name" has a space`
	t.Run(name, func(t *testing.T) {})
}

func TestFunctionValue(t *testing.T) {
	t.Run("a named function", probe) // want `subtest name "a named function" has a space`
}

func probe(t *testing.T) {}

func TestNotASubtest(t *testing.T) {
	var u struct{ Run func(string, int) }
	u.Run = func(string, int) {}
	u.Run("not a subtest", 1)
}
