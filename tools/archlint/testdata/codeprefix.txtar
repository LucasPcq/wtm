-- github.com/LucasPcq/wtm/next/internal/domain/domain.go --
// Package domain is the domain.
package domain

const CodeRequired = "required"

type Code string

type Warning struct{ Code, Message string }
-- github.com/LucasPcq/wtm/next/internal/command/create/create.go --
// Package create creates worktrees.
package create

import "github.com/LucasPcq/wtm/next/internal/domain"

const Name = "create"

const CodeConfigNotFound = "create.config_not_found"

const codeRequired = "required" // want `code "required" is declared in command/create: it must start with "create."`

const codeConverted = domain.Code("converted") // want `code "converted" is declared in command/create`

const codeJoined = Name + ".joined"

const codec = "json"

var codeVar = "var" // want `code "var" is declared in command/create`

var (
	_ = domain.Warning{Code: "create.ff_dirty"}
	_ = domain.Warning{Code: "extract.ff_dirty"} // want `code "extract.ff_dirty" is declared in command/create`
	_ = domain.Warning{Code: "distinct", Message: "not_found"} // want `code "distinct" is declared in command/create`
	_ = domain.Warning{Code: ("paren")} // want `code "paren" is declared in command/create`
	_ = domain.Warning{Code: Name + ".built"}
	_ = domain.Warning{Code: domain.CodeRequired}
	_ = domain.Warning{Code: codeRequired}
	_ = codec
	_ = codeVar
)
