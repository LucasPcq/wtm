-- github.com/LucasPcq/wtm/next/internal/command/create/cli/cli.go --
// Package cli is create's command line.
package cli

import (
	"github.com/LucasPcq/wtm/next/internal/command/create"
	"github.com/LucasPcq/wtm/next/internal/domain"
)

var _ = domain.Warning{Code: "cli.flag"} // want `code "cli.flag" is declared in command/create`

var _ = domain.Warning{Code: create.Name + ".flag"}
-- github.com/LucasPcq/wtm/next/internal/command/fastforward/fastforward.go --
// Package fastforward advances branches: its Name is not its directory's.
package fastforward

import "github.com/LucasPcq/wtm/next/internal/domain"

const Name = "fast-forward"

var (
	_ = domain.Warning{Code: "fast-forward.busy"}
	_ = domain.Warning{Code: "fastforward.busy"} // want `code "fastforward.busy" is declared in command/fastforward: it must start with "fast-forward."`
)
