-- github.com/LucasPcq/wtm/internal/kernel/kernel.go --
package kernel // want package:"3 kernel codes"

type Code string

type Params map[string]string

const (
	CodeRequired Code = "required"
	CodeMissing  Code = "missing"
)

func Problem(code Code) Code { return code }

var _ = Problem(Code("unit.spoken"))
-- github.com/LucasPcq/wtm/internal/kernel/text/text.go --
package text // want `code "missing" \(kernel.go:9\) has no message in the catalogue of kernel/text` `code "unit.spoken" \(kernel.go:14\) has no message`

import "github.com/LucasPcq/wtm/internal/kernel"

type Messages map[kernel.Code]string

const codeDone kernel.Code = "status.done"

const codeSilent kernel.Code = "status.silent" // want `code "status.silent" \(text.go:9\) has no message in the catalogue of kernel/text`

var kernelMessages = Messages{
	kernel.CodeRequired: "{path} is required",
	codeDone:            "done",
	"stray":             "a message no constant declares", // want `message keyed by a bare string`
}

func Dynamic(because string) kernel.Code { return kernel.Code(because) }
-- github.com/LucasPcq/wtm/internal/command/create/create.go --
package create

import (
	"github.com/LucasPcq/wtm/internal/kernel"
	"github.com/LucasPcq/wtm/internal/kernel/text"
)

const (
	CodeBranchTaken kernel.Code = "create.branch_taken"
	CodeSilent      kernel.Code = "create.silent" // want `code "create.silent" \(create.go:10\) has no message in the catalogue of command/create`
)

var Messages = text.Messages{
	CodeBranchTaken: "{branch} is taken",
}

var _ = kernel.Problem(kernel.Code("create.converted")) // want `code "create.converted" \(create.go:17\) has no message in the catalogue of command/create`
