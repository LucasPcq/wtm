package worktree

func writeMetadata() error { return nil }

func purgeState() {}

func persist() error { return writeMetadata() }

func Create() error { return writeMetadata() }

func Sneaky() error { return persist() } // want `worktree\.Sneaky writes worktree metadata but is not in the mutators table`

func Purges() { purgeState() } // want `worktree\.Purges writes worktree metadata`

func Reads() error { return nil }

func Closure() func() error { // want `worktree\.Closure writes worktree metadata`
	return func() error { return writeMetadata() }
}

type T struct{}

func (T) Method() error { return writeMetadata() }
