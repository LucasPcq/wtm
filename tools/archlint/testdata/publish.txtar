-- github.com/LucasPcq/wtm/internal/domain/domain.go --
package domain

type Event struct{}
-- github.com/LucasPcq/wtm/internal/service/process/process.go --
package process

func Publish() error { return nil }

func relay() error { return Publish() }
-- github.com/LucasPcq/wtm/internal/service/events/events.go --
package events

import "github.com/LucasPcq/wtm/internal/service/process"

func Send() error { return process.Publish() }
-- github.com/LucasPcq/wtm/internal/service/runjobs/runjobs.go --
package runjobs

import proc "github.com/LucasPcq/wtm/internal/service/process"

func Send() error { return proc.Publish() } // want `process\.Publish is called from service/runjobs: only service/events publishes`
-- github.com/LucasPcq/wtm/internal/flow/flow.go --
package flow

import "github.com/LucasPcq/wtm/internal/domain"

type Publisher interface{ Publish(domain.Event) }

type Context struct{ Publisher Publisher }

func (c Context) Publish(event domain.Event) { c.Publisher.Publish(event) }
-- github.com/LucasPcq/wtm/internal/flow/create/create.go --
package create

import (
	"github.com/LucasPcq/wtm/internal/domain"
	"github.com/LucasPcq/wtm/internal/flow"
)

func Run(ctx flow.Context) { ctx.Publish(domain.Event{}) }
-- github.com/LucasPcq/wtm/internal/surface/tui/dash/dash.go --
package dash

import (
	"github.com/LucasPcq/wtm/internal/domain"
	"github.com/LucasPcq/wtm/internal/flow"
)

func Run(ctx flow.Context, p flow.Publisher) {
	ctx.Publish(domain.Event{})   // want `flow\.Context\.Publish is called from surface/tui/: only internal/flow publishes`
	p.Publish(domain.Event{})     // want `flow\.Publisher\.Publish is called from surface/tui/: only internal/flow publishes`
}
-- github.com/LucasPcq/wtm/internal/dispatch/dispatch.go --
package dispatch

import "github.com/LucasPcq/wtm/internal/domain"

type Publisher interface{ Publish(domain.Event) }

type bus struct{ publisher Publisher }

func (b bus) publish(event domain.Event) { b.publisher.Publish(event) }
-- github.com/LucasPcq/wtm/internal/surface/cli/run/run.go --
package run

import (
	"github.com/LucasPcq/wtm/internal/dispatch"
	"github.com/LucasPcq/wtm/internal/domain"
)

func Report(p dispatch.Publisher) {
	p.Publish(domain.Event{}) // want `dispatch\.Publisher\.Publish is called from surface/cli/run: only dispatch publishes`
}
-- github.com/LucasPcq/wtm/internal/command/create/create.go --
package create

import (
	"github.com/LucasPcq/wtm/internal/dispatch"
	"github.com/LucasPcq/wtm/internal/domain"
)

type Announcer interface{ Publish(domain.Event) }

func Apply(a Announcer, p dispatch.Publisher) {
	a.Publish(domain.Event{}) // want `command/create publishes: in the engine only dispatch publishes`
	p.Publish(domain.Event{}) // want `command/create publishes`
}
-- github.com/LucasPcq/wtm/internal/service/identity/identity.go --
package identity

import "github.com/LucasPcq/wtm/internal/service/process"

func Allocate() error { return process.Publish() } // want `service/identity publishes`
