-- github.com/LucasPcq/wtm/internal/styles/styles.go --
package styles

type Style struct{ faint bool }

func (s Style) Render(text ...string) string { return "" }

var (
	Muted          = Style{faint: true}
	Accent         = Style{}
	BadgeOK        = Style{}
	DashboardTitle = Style{}
)
