package kernel

type Code string
-- github.com/LucasPcq/wtm/internal/command/create/create.go --
package create

import (
	"errors"
	"fmt"

	"github.com/LucasPcq/wtm/internal/kernel"
)

const CodeTaken kernel.Code = "create.taken"

const missing = "the branch is required"

var ErrTaken = errors.New("branch taken") // want `errors\.New with English text in command/create: the engine emits a kernel\.Code`

func Check(branch string, err error) (kernel.Code, error) {
	if branch == "" {
		return "", errors.New(missing) // want `errors\.New with English text`
	}
	if err != nil {
		return "", fmt.Errorf("%w", err)
	}
	return kernel.Code(fmt.Sprintf("create.%s", branch)), fmt.Errorf("branch %s: %w", branch, err) // want `kernel\.Code built from a value in command/create` `fmt\.Errorf with English text`
}

var _ = kernel.Code("create.dirty")
