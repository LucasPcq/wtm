-- github.com/LucasPcq/wtm/internal/flow/unhooked/unhooked.go --
package unhooked

import (
	"github.com/LucasPcq/wtm/internal/flow/publish"
	"github.com/LucasPcq/wtm/internal/service/worktree"
)

func Run() error {
	defer publish.Removed()
	return worktree.Clean() // want `worktree\.Clean changes a worktree's identity but this package never publishes worktree\.deprovisioned`
}
