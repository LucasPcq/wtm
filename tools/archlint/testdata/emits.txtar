package untested

import (
	"github.com/LucasPcq/wtm/internal/flow/publish"
	"github.com/LucasPcq/wtm/internal/service/worktree"
)

func Run() error {
	publish.Created()
	publish.Provisioned()
	return worktree.Create() // want `worktree\.Create changes a worktree's identity but no test of this package records what it publishes`
}
