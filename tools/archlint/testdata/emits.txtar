-- github.com/LucasPcq/wtm/internal/testutil/flowtest/flowtest.go --
package flowtest

type Recorder struct{}
-- github.com/LucasPcq/wtm/internal/flow/good/good.go --
package good

import (
	"github.com/LucasPcq/wtm/internal/flow/publish"
	wt "github.com/LucasPcq/wtm/internal/service/worktree"
)

func Run() error {
	if err := wt.Create(); err != nil {
		return err
	}
	publish.Created()
	publish.Provisioned()
	return wt.Sync()
}
