-- github.com/LucasPcq/wtm/internal/registry/registry.go --
package registry

import (
	"github.com/LucasPcq/wtm/internal/command/create"
	"github.com/LucasPcq/wtm/internal/dispatch"
)

func Events() dispatch.Events { // want Events:"mutator via registry.committed"
	return dispatch.Events{Committed: committed} // want `registry\.committed writes \(create\.Events → store\.Meta\.Update → fs\.UpdateFile\), as Committed: only Apply writes`
}

func committed() error { return create.Events(create.Ports{}) } // want committed:"mutator via create.Events → store.Meta.Update → fs.UpdateFile"
