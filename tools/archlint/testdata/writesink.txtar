package status

import "github.com/LucasPcq/wtm/internal/service/runenv"

func Keep() error { // want Keep:"mutator via runenv.Save"
	return runenv.Save(1) // want `runenv\.Save writes \(fs\.UpdateFile\), in query/status`
}
