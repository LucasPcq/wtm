-- github.com/LucasPcq/wtm/internal/query/status/status.go --
package status

import (
	"context"

	"github.com/LucasPcq/wtm/internal/infra/git"
	"github.com/LucasPcq/wtm/internal/kernel"
	"github.com/LucasPcq/wtm/internal/service/identity"
	"github.com/LucasPcq/wtm/internal/store"
)

func Query(reader git.Reader, meta store.Meta) kernel.Query[identity.Snapshot] {
	return kernel.Query[identity.Snapshot]{Run: func(context.Context) (identity.Snapshot, error) {
		return identity.Read(reader, meta)
	}}
}

func Number(meta store.Meta) error { // want Number:"mutator via identity.Allocate"
	return identity.Allocate(meta) // want `identity\.Allocate writes \(identity\.claim → store\.Meta\.Update → fs\.UpdateFile\), in query/status: a query only reads`
}

func Touch(meta store.Meta) error { // want Touch:"mutator via store.Meta.Update"
	return meta.Update("feat") // want `store\.Meta\.Update writes \(fs\.UpdateFile\), in query/status`
}
-- github.com/LucasPcq/wtm/internal/command/create/create.go --
package create

import (
	"context"
	"os"

	"github.com/LucasPcq/wtm/internal/infra/fs"
	"github.com/LucasPcq/wtm/internal/infra/git"
	"github.com/LucasPcq/wtm/internal/kernel"
	"github.com/LucasPcq/wtm/internal/service/gitwt"
	"github.com/LucasPcq/wtm/internal/service/identity"
	"github.com/LucasPcq/wtm/internal/store"
)

type ports struct {
	git  git.Writer
	meta store.Meta
}

type Ports = ports

func Command(p ports) kernel.Command[identity.Snapshot] { // want Command:"mutator via identity.Allocate"
	return kernel.Command[identity.Snapshot]{
		Name: "create",
		Observe: func(ctx context.Context) (identity.Snapshot, error) {
			if err := identity.Allocate(p.meta); err != nil { // want `identity\.Allocate writes \(identity\.claim → store\.Meta\.Update → fs\.UpdateFile\), in Observe: only Apply writes`
				return identity.Snapshot{}, err
			}
			return identity.Snapshot{}, nil
		},
		Fields: []kernel.FieldDef[identity.Snapshot]{{
			Validate: func(identity.Snapshot) []string {
				_ = os.MkdirAll("x", 0o755) // want `os\.MkdirAll writes, in Validate: only Apply writes`
				return nil
			},
			Choices: func(ctx context.Context, _ identity.Snapshot) ([]string, error) { return nil, p.meta.Update("feat") }, // want `store\.Meta\.Update writes \(fs\.UpdateFile\), in Choices: only Apply writes`
		}},
		Plan: p.plan, // want `create\.ports\.plan writes \(fs\.UpdateFile\), as Plan: only Apply writes`
		Apply: func(ctx context.Context, in kernel.ApplyInput[identity.Snapshot]) error {
			if err := identity.Allocate(p.meta); err != nil {
				return err
			}
			return kernel.Each(ctx, kernel.EachParams{Milestones: in.Milestones, Units: []kernel.Unit{{
				Before: []kernel.Prep{{Name: "fetch", Run: func(ctx context.Context, _ kernel.Reporter) error { return p.meta.Update("fetch") }}},
				Saga: kernel.Saga{
					Steps: []kernel.SagaStep{{
						Name: "worktree",
						Do:   func(ctx context.Context, _ kernel.Reporter) error { return gitwt.Add(p.git, "feat") },
						Undo: func(ctx context.Context) error { return gitwt.Add(p.git, "undo") },
					}},
					Commit: func(ctx context.Context) error { return p.meta.Update("feat") },
				},
				Then: []kernel.Phase{{Name: "hooks", Run: func(ctx context.Context, _ kernel.Reporter) error { return p.meta.Update("feat") }}},
			}}})
		},
	}
}

// A saga built outside the literal is still Apply's: its steps write.
func unit(p ports) kernel.Unit { // want unit:"mutator via gitwt.Add → git.Writer.AddWorktree"
	return kernel.Unit{Saga: kernel.Saga{Steps: []kernel.SagaStep{{
		Do: func(ctx context.Context, _ kernel.Reporter) error { return gitwt.Add(p.git, "feat") },
	}}}}
}

func Built(p ports) kernel.Command[identity.Snapshot] { // want Built:"mutator via create.observer → store.Meta.Update → fs.UpdateFile"
	return kernel.Command[identity.Snapshot]{
		Observe: observer(p), // want `create\.observer writes \(store\.Meta\.Update → fs\.UpdateFile\), building Observe: only Apply writes`
		Locks:   locks(p),
	}
}

func observer(p ports) func(context.Context) (identity.Snapshot, error) { // want observer:"mutator via store.Meta.Update → fs.UpdateFile"
	return func(ctx context.Context) (identity.Snapshot, error) {
		return identity.Snapshot{}, p.meta.Update("feat")
	}
}

func locks(p ports) func(identity.Snapshot) []string {
	return func(identity.Snapshot) []string { return nil }
}

func Assigned(p ports) kernel.Command[identity.Snapshot] { // want Assigned:"mutator via os.Setenv"
	var command kernel.Command[identity.Snapshot]
	command.Locks = func(identity.Snapshot) []string {
		_ = os.Setenv("A", "b") // want `os\.Setenv writes, in Locks: only Apply writes`
		return nil
	}
	command.Apply = func(ctx context.Context, _ kernel.ApplyInput[identity.Snapshot]) error { return os.Chdir("/") }
	return command
}

func Events(p ports) error { return p.meta.Update("feat") } // want Events:"mutator via store.Meta.Update → fs.UpdateFile"

func (p ports) plan(ctx context.Context, snapshot identity.Snapshot) error { // want plan:"mutator via fs.UpdateFile"
	return fs.UpdateFile("plan")
}
