package runenv

import (
	"os"

	"github.com/LucasPcq/wtm/internal/infra/fs"
)

func Env(path string) ([]byte, error) {
	if !fs.FileExists(path) {
		return nil, nil
	}
	return os.ReadFile(path)
}
