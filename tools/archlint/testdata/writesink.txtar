import (
	"github.com/LucasPcq/wtm/internal/service/identity"
	"github.com/LucasPcq/wtm/internal/store"
)

func Run(meta store.Meta) error { return identity.Allocate(meta) } // want Run:"mutator via identity.Allocate → identity.claim" `identity\.Allocate writes \(identity\.claim → store\.Meta\.Update → fs\.UpdateFile\), called from flow/create: a mutator of the engine's services is called from command/ or another service only`
