)

func Add(writer git.Writer) error { // want Add:"mutator via gitwt.Add → git.Writer.AddWorktree"
	return gitwt.Add(writer, "feat") // want `gitwt\.Add writes \(git\.Writer\.AddWorktree\), called from surface/cli/wt: a mutator of the engine's services is called from command/ or another service only`
}

func Show(reader git.Reader, meta store.Meta) (identity.Snapshot, error) { return identity.Read(reader, meta) }

var number = identity.Allocate // want `identity\.Allocate writes \(identity\.claim → store\.Meta\.Update → fs\.UpdateFile\), called from surface/cli/wt`
