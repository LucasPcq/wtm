-- github.com/LucasPcq/wtm/next/internal/service/provision/provision.go --
// Package provision makes a worktree whole.
package provision

import (
	"os"
	sys "os"
	"syscall"
)

var (
	_    = os.Getenv("HOME")       // want `next/internal/service/provision reads the environment \(os.Getenv\)`
	_, _ = os.LookupEnv("HOME")    // want `reads the environment \(os.LookupEnv\)`
	_    = sys.Environ()           // want `reads the environment \(os.Environ\)`
	_    = os.Getenv               // want `reads the environment \(os.Getenv\)`
	_    = os.Getpid()
	_    = os.ExpandEnv("$HOME")   // want `reads the environment \(os.ExpandEnv\)`
	_, _ = os.UserHomeDir()        // want `reads the environment \(os.UserHomeDir\)`
	_, _ = os.UserConfigDir()      // want `reads the environment \(os.UserConfigDir\)`
	_, _ = os.UserCacheDir()       // want `reads the environment \(os.UserCacheDir\)`
	_    = syscall.Getenv          // want `reads the environment \(syscall.Getenv\)`
	_, _ = syscall.Getenv("X")     // want `reads the environment \(syscall.Getenv\)`
	_    = syscall.Environ()       // want `reads the environment \(syscall.Environ\)`
	_    = syscall.Getpid()
)
