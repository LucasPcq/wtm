package store

type Meta interface{ Update(branch string) error }

type MetaDisk struct{ StateDir string }

func (m MetaDisk) Update(branch string) error { return nil }

var _ Meta = MetaDisk{}

type MetaUpdate struct{ Branch string }
-- github.com/LucasPcq/wtm/internal/infra/git/repo.go --
package git

type Writer interface{ AddWorktree(path string) error }

type Repo struct{ Dir string }

func (r Repo) AddWorktree(path string) error { return nil }

type Ref interface{ ref() }

type LocalBranch struct{ Name string }

func (LocalBranch) ref() {}
-- github.com/LucasPcq/wtm/internal/command/create/create.go --
package create

import (
	"github.com/LucasPcq/wtm/internal/infra/git"
	"github.com/LucasPcq/wtm/internal/store"
)

type Ports struct {
	Git  git.Writer
	Meta store.Meta
}

func Own(stateDir string) Ports {
	var repo git.Repo // want `git\.Repo built in command/create: a real port is built by internal/registry`
	repo.Dir = stateDir
	return Ports{
		Git:  repo,
		Meta: store.MetaDisk{StateDir: stateDir}, // want `store\.MetaDisk built in command/create`
	}
}

func Fresh() *git.Repo { return new(git.Repo) } // want `git\.Repo built in command/create`

func Update(branch string) store.MetaUpdate { return store.MetaUpdate{Branch: branch} }

func Branch(name string) git.Ref { return git.LocalBranch{Name: name} }
-- github.com/LucasPcq/wtm/internal/registry/registry.go --
package registry

import (
	"github.com/LucasPcq/wtm/internal/command/create"
	"github.com/LucasPcq/wtm/internal/infra/git"
	"github.com/LucasPcq/wtm/internal/store"
)

func Production(dir, stateDir string) create.Ports {
	return create.Ports{Git: git.Repo{Dir: dir}, Meta: store.MetaDisk{StateDir: stateDir}}
}
