-- github.com/LucasPcq/wtm/next/internal/domain/branch/branch.go --
//go:build !plan9

// Package branch names branches.
package branch // want `next/internal/domain/branch has 6 comment lines, above its ceiling of 0 in .next-comments`

import "strings"

//go-sumtype:decl Ref
type Ref interface{ ref() }

//nolint:unused
var unusedName = ""

//nolint this is an essay
var essay = ""

// Problem says why a name is not a branch name.
// It spans two lines.
func Problem(name string) string {
	// git refuses a name ending in .lock
	if strings.HasSuffix(name, ".lock") {
		return "ends with .lock"
	}
	return ""
}

type clash struct{}

// Name is exported on an unexported type.
func (clash) Name() string { return "" }

func trimmed(name string) string { return strings.TrimSpace(name) + essay + unusedName }
