// Package dotenv parses .env files. // want `next/internal/domain/dotenv has a package doc of 2 lines`
// It keeps their format.
package dotenv

// lines is what a file holds.
type lines []string

func Parse(data string) lines {
	// a CRLF file stays CRLF
	return lines{data}
}
