-- github.com/LucasPcq/wtm/next/internal/wtm/branch/branch.go --
// Package branch names branches.
package branch

import "strings"

// Problem says why a name is not a branch name.
func Problem(name string) string {
	// git refuses a name ending in .lock
	if strings.HasSuffix(name, ".lock") {
		return "ends with .lock"
	}
	return ""
}

// Clash is two names git cannot hold together.
type Clash struct {
	A, B string
}

//go:noinline
func trimmed(name string) string { return strings.TrimSpace(name) }
-- github.com/LucasPcq/wtm/next/internal/wtm/branch/branch_test.go --
package branch

import "testing"

func TestProblem(t *testing.T) {
	_ = Problem("x")
	_ = trimmed("x")
}
-- github.com/LucasPcq/wtm/next/internal/wtm/dotenv/dotenv.go --
// Package dotenv parses .env files. // want `next/internal/wtm/dotenv has a package doc of 2 lines`
// It keeps their format.
package dotenv

// lines is what a file holds.
type lines []string

// Parse splits a file into lines.
func Parse(data string) lines {
	// a CRLF file stays CRLF
	return lines{data}
}
