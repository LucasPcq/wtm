---
import Dashboard from './Dashboard.astro';
import Session from './Session.astro';
import { base } from '../../lib/base.mjs';
import { cmd, out } from '../../lib/term.mjs';

const create = [
  cmd('wtm create feat/login feat/search fix/header --yes'),
  out(),
  out('  <span class="m">›</span> feat/login <span class="m">(1/3)</span>'),
  out('  <span class="m">›</span> feat/search <span class="m">(2/3)</span>'),
  out('  <span class="m">›</span> fix/header <span class="m">(3/3)</span>'),
  out(),
  out('  <span class="g">✓</span> feat/login'),
  out('    <span class="m">../acme.trees/feat-login</span>'),
  out('  <span class="g">✓</span> feat/search'),
  out('    <span class="m">../acme.trees/feat-search</span>'),
  out('  <span class="g">✓</span> fix/header'),
  out('    <span class="m">../acme.trees/fix-header</span>'),
  out(),
  out('  3 created'),
];
const run = [
  cmd('wtm run up feat/login feat/search -d --yes'),
  out(),
  out('  Profile dev · 2 worktrees'),
  out(),
  out('  <span class="g">✓</span> api started · feat/search · <span class="c">http://api.feat-search.acme.localhost</span>'),
  out('  <span class="g">✓</span> api started · feat/login · <span class="c">http://api.feat-login.acme.localhost</span>'),
  out('  <span class="g">✓</span> web started · feat/search · <span class="c">http://web.feat-search.acme.localhost</span>'),
  out('  <span class="g">✓</span> web started · feat/login · <span class="c">http://web.feat-login.acme.localhost</span>'),
  out(),
  cmd('wtm run ps'),
  out(),
  out('  <span class="m">NAME  STATUS   ADDRESS                                WORKTREE</span>'),
  out('  api   <span class="g">running</span>  <span class="c">http://api.feat-login.acme.localhost</span>   feat/login'),
  out('  web   <span class="g">running</span>  <span class="c">http://web.feat-login.acme.localhost</span>   feat/login'),
  out('  api   <span class="g">running</span>  <span class="c">http://api.feat-search.acme.localhost</span>  feat/search'),
  out('  web   <span class="g">running</span>  <span class="c">http://web.feat-search.acme.localhost</span>  feat/search'),
];
const stacks = [
  cmd('wtm tree'),
  out(),
  out('  main'),
  out('  ├─ feat/login        <span class="m">base ↑1</span>  <span class="y">⚠ needs sync</span>'),
  out('  │  └─ feat/login-ui  <span class="m">base ↑1</span>'),
  out('  ├─ feat/search       <span class="y">⚠ needs sync</span>'),
  out('  └─ fix/header        <span class="y">⚠ needs sync</span>'),
  out(),
  cmd('wtm sync --all --yes'),
  out(),
  out('  <span class="g">✓</span> feat/login rebased onto main   <span class="m">1 commits</span>'),
  out('  <span class="g">✓</span> feat/search rebased onto main   <span class="m">0 commits</span>'),
  out('  <span class="g">✓</span> fix/header rebased onto main   <span class="m">0 commits</span>'),
  out('  <span class="g">✓</span> feat/login-ui rebased onto feat/login   <span class="m">1 commits</span>'),
  out(),
  out('  4 branch(es) ready to push (force-with-lease).'),
];
---
<section class="section" id="features">
  <div class="wrap">
    <p class="prompt">wtm --help</p>
    <h2>Create, run, watch, sync.</h2>
    <p class="lede">Four commands cover the day. Every terminal on this page replays what wtm printed in a sandbox repository called <code>acme</code>, trimmed to fit.</p>

    <div class="feature">
      <div>
        <span class="cmdname">wtm create</span>
        <h3>Worktrees, ready to work in</h3>
        <p>Several branches in one command. Each worktree gets its <code>.env</code> files copied and your <code>on_create</code> hooks run (<code>pnpm install</code>…). <code>wtm clean</code> refuses anything uncommitted or unpushed.</p>
      </div>
      <Session title="~/code/acme" lines={create} />
    </div>

    <div class="feature">
      <div>
        <span class="cmdname">wtm run up</span>
        <h3>A whole stack per worktree</h3>
        <p>Declare your jobs once in <code>run.toml</code>; <code>wtm run init</code> writes it from your Compose files and package scripts. Each worktree runs it on its own ports, Compose project and database, behind its own <code>*.localhost</code> URL (on port 80 once <code>wtm run proxy install</code> redirects it).</p>
        <p><a href={`${base}guide/how-run-works/`}>How wtm run works →</a></p>
      </div>
      <Session title="~/code/acme" lines={run} />
    </div>

    <div class="feature wide">
      <div>
        <span class="cmdname">wtm ui</span>
        <h3>One screen for all of it</h3>
        <p>Every worktree, the branch tree and the running services, updated live as worktrees come and go from any shell or agent. Pull request status shows up when <code>gh</code> is connected.</p>
      </div>
      <Dashboard />
    </div>

    <div class="feature">
      <div>
        <span class="cmdname">wtm sync</span>
        <h3>Stacked branches, rebased in order</h3>
        <p>Branch off a branch. When <code>main</code> moves, <code>wtm sync</code> rebases the whole chain, parents before children, and aborts cleanly on a conflict.</p>
      </div>
      <Session title="~/code/acme" lines={stacks} />
    </div>
  </div>
</section>
