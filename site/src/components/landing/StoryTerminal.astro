---
type Line = { text: string; cls?: string };
const before: Line[] = [
  { text: '# four agents, one checkout, one machine', cls: 'dim' },
  { text: 'agent-1 $ pnpm dev', cls: 'p' },
  { text: '  ✓ web ready on http://localhost:3000', cls: 'ok' },
  { text: 'agent-2 $ pnpm dev', cls: 'p' },
  { text: '  ✗ Error: listen EADDRINUSE: address already in use :::3000', cls: 'err' },
  { text: 'agent-3 $ docker compose up -d', cls: 'p' },
  { text: '  ✗ container acme-postgres-1 is already in use', cls: 'err' },
  { text: 'agent-4 $ pnpm db:migrate', cls: 'p' },
  { text: '  ✗ relation "orders" already exists (agent-1 migrated it)', cls: 'err' },
];
const after: Line[] = [
  { text: '# one worktree and one stack per agent', cls: 'dim' },
  { text: '$ wtm create agent/a agent/b agent/c agent/d --yes', cls: 'p' },
  { text: '  ✓ 4 worktrees · .env copied · pnpm install', cls: 'ok' },
  { text: '$ wtm run up agent/a agent/b agent/c agent/d -d --yes', cls: 'p' },
  { text: '  ✓ agent/a  web.agent-a.acme.localhost  db app_agent-a', cls: 'ok' },
  { text: '  ✓ agent/b  web.agent-b.acme.localhost  db app_agent-b', cls: 'ok' },
  { text: '  ✓ agent/c  web.agent-c.acme.localhost  db app_agent-c', cls: 'ok' },
  { text: '  ✓ agent/d  web.agent-d.acme.localhost  db app_agent-d', cls: 'ok' },
  { text: '# 4 stacks · 0 collisions', cls: 'dim' },
];
---
<div class="story">
  <input type="radio" name="story" id="story-before" />
  <input type="radio" name="story" id="story-after" checked />
  <div class="story-toggle mono">
    <label for="story-before">without wtm</label>
    <label for="story-after">with wtm</label>
  </div>
  <div class="term">
    <div class="term-bar"><i></i><i></i><i></i><b>~/code/acme</b></div>
    <pre class="term-body story-scene" data-scene="before">{before.map((l) => <span class={`line ${l.cls ?? ''}`}>{l.text}{'\n'}</span>)}</pre>
    <pre class="term-body story-scene" data-scene="after">{after.map((l) => <span class={`line ${l.cls ?? ''}`}>{l.text}{'\n'}</span>)}</pre>
  </div>
</div>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const story = document.querySelector<HTMLElement>('.story');
  const play = (scene: Element) => {
    if (reduced) return;
    const lines = [...scene.querySelectorAll<HTMLElement>('.line')];
    lines.forEach((line) => line.classList.add('pending'));
    lines.forEach((line, i) => setTimeout(() => line.classList.remove('pending'), 260 * (i + 1)));
  };
  const sceneFor = (id: string) => story?.querySelector(`[data-scene="${id === 'story-before' ? 'before' : 'after'}"]`);
  let autoplay: ReturnType<typeof setTimeout> | undefined;
  story?.querySelector('.story-toggle')?.addEventListener('click', () => clearTimeout(autoplay));
  story?.querySelectorAll<HTMLInputElement>('input[name="story"]').forEach((input) =>
    input.addEventListener('change', () => { clearTimeout(autoplay); const s = sceneFor(input.id); if (s) play(s); }),
  );
  if (story && !reduced) {
    const beforeInput = story.querySelector<HTMLInputElement>('#story-before');
    const afterInput = story.querySelector<HTMLInputElement>('#story-after');
    const seen = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting || !beforeInput || !afterInput) return;
      seen.disconnect();
      beforeInput.checked = true;
      play(sceneFor('story-before')!);
      autoplay = setTimeout(() => { afterInput.checked = true; play(sceneFor('story-after')!); }, 260 * 9 + 1600);
    });
    seen.observe(story);
  }
</script>
