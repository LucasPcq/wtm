---
import { base } from '../../lib/base.mjs';

interface Props { facts: { releases: number; latest: string; since: string; recent: { version: string; date: string; summary: string }[] } }
const { facts } = Astro.props;
const anchor = (r: { version: string; date: string }) => `${base}changelog/#${r.version.replaceAll('.', '')}---${r.date}`;
---
<section class="section">
  <div class="wrap">
    <p class="prompt">git tag --list 'v*'</p>
    <h2>{facts.releases} releases since {facts.since}.</h2>
    <p class="lede">Shipped in the open, every week, each with its changelog and a migration note when something moves.</p>
    <ol class="log">
      {facts.recent.map((r) => (
        <li><a href={anchor(r)}>v{r.version}</a><time datetime={r.date}>{r.date}</time><span>{r.summary.split('`').map((part, i) => (i % 2 ? <code>{part}</code> : part))}</span></li>
      ))}
    </ol>
    <p class="facts"><span>Free and open source (MIT)</span><span>macOS, Linux, Windows through WSL2</span><span>Homebrew, Go, binaries</span><span><a href={`${base}changelog/`}>Full changelog</a></span></p>
  </div>
</section>
