---
import { base } from '../../lib/base.mjs';
import { lanes } from '../../lib/machine.mjs';

const install = 'brew install LucasPcq/tap/wtm';
const windows = lanes().map((lane, i) => ({ ...lane, top: ['18.6%', '50%', '81.4%'][i], color: `var(--lane-${i + 1})`, delay: `${i * 120}ms` }));
---
<section class="hero">
  <div class="wrap">
    <div>
      <h1 class="pair"><span class="light">Every branch,</span><span class="heavy">running.</span></h1>
      <p class="sub">A git worktree manager that gives each branch its own ports, Compose project, database and URL. Your agents run their app and test their work. Yours keeps running.</p>
      <div class="cta-row">
        <div class="install">
          <code>{install}</code>
          <button class="copy" type="button" data-copy={install}>copy</button>
        </div>
        <a class="btn btn-primary" href={`${base}guide/getting-started/`}>Get started</a>
      </div>
      <p class="platforms">macOS · Linux · WSL2 — also <a href={`${base}guide/installation/`}>go install, binaries</a></p>
    </div>

    <figure class="collision" data-phase="3" aria-label="Three branches collide on port 3000, then each runs at its own address">
      <div class="collision-bar">
        <span>~/code/acme</span>
        <button class="replay" type="button" hidden>replay</button>
      </div>
      <div class="stage">
        <svg viewBox="0 0 600 440" aria-hidden="true">
          <circle cx="26" cy="220" r="7" fill="var(--strong)" />
          <g class="lanes knot" fill="none" stroke-width="7" stroke-linecap="round">
            <path d="M 30 220 C 70 190, 100 250, 140 230 S 200 200, 240 222 C 262 222, 276 220, 300 220" stroke="var(--lane-1)" />
            <path d="M 30 220 C 70 250, 110 190, 150 212 S 210 240, 240 220 C 262 220, 276 220, 300 220" stroke="var(--lane-2)" />
            <path d="M 30 220 C 70 220, 110 240, 150 226 S 205 212, 240 218 C 262 218, 276 220, 300 220" stroke="var(--lane-3)" />
          </g>
          <g class="lanes split-lanes" fill="none" stroke-width="7" stroke-linecap="round">
            <path d="M 30 220 C 90 220, 120 218, 160 214 C 230 206, 236 82, 300 82" stroke="var(--lane-1)" />
            <path d="M 30 220 C 120 220, 220 220, 300 220" stroke="var(--lane-2)" />
            <path d="M 30 220 C 90 220, 120 222, 160 226 C 230 234, 236 358, 300 358" stroke="var(--lane-3)" />
          </g>
        </svg>
        <div class="window port-3000">
          <div class="url">localhost:3000</div>
          <ul>
            <li>✗ EADDRINUSE :::3000</li>
            <li>✗ container "/acme-postgres-1" in use</li>
            <li>✗ DATABASE_URL not found</li>
          </ul>
        </div>
        {windows.map((w) => (
          <div class="window arrival" style={`top: ${w.top}; --lane: ${w.color}; --delay: ${w.delay}`}>
            <div class="url">{w.url}</div>
            <div class="meta"><span>{w.who} · {w.branch}</span><span>:{w.webPort}</span></div>
          </div>
        ))}
      </div>
    </figure>
  </div>
</section>
