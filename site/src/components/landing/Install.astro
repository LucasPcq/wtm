---
const tabs = [
  { key: 'brew', label: 'Homebrew' },
  { key: 'go', label: 'Go' },
  { key: 'bin', label: 'Binary' },
];
const commands = [
  { key: 'brew', cmd: 'brew install LucasPcq/tap/wtm' },
  { key: 'go', cmd: 'go install github.com/LucasPcq/wtm@latest' },
];
---
<div class="install">
  <div class="install-tabs" role="radiogroup" aria-label="Install method">
    {tabs.map((c, i) => (
      <>
        <input type="radio" name="install" id={`i-${c.key}`} checked={i === 0} />
        <label for={`i-${c.key}`}>{c.label}</label>
      </>
    ))}
  </div>
  {commands.map((c) => (
    <div class="install-cmd" data-k={c.key}>
      <code>{c.cmd}</code>
      <button class="copy" type="button" data-copy={c.cmd}>copy</button>
    </div>
  ))}
  <a class="install-link" href="https://github.com/LucasPcq/wtm/releases/latest">Download a release for macOS or Linux →</a>
</div>
