---
const columns = [
  { k: 'now', items: ['A live event bus for every repository (wtm events)', 'A dashboard that runs flows and opens a terminal in a worktree'] },
  { k: 'next', items: ['An orchestration module: one agent per issue, spawned, tracked and cleaned up by wtm'] },
  { k: 'exploring · on the Claude API', items: ['Writing run.toml from an analysis of the repository', 'Assisted conflict resolution while wtm sync rebases a stack', 'Descriptions for a stack of pull requests'] },
];
---
<section class="section">
  <div class="wrap">
    <p class="section-label">roadmap</p>
    <h2>From isolated stacks to orchestrated agents.</h2>
    <div class="roadmap">
      {columns.map((c) => (
        <div><h3 class="mono">{c.k}</h3><ul>{c.items.map((i) => <li>{i}</li>)}</ul></div>
      ))}
    </div>
  </div>
</section>
