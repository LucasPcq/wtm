---
import { render, type Line } from '../../lib/term.mjs';

interface Props { title: string; lines: Line[]; wide?: boolean }
const { title, lines, wide } = Astro.props;
---
<figure class="term" data-play>
  <div class="term-bar">
    <span>{title}</span>
    <button class="replay" type="button" hidden>replay</button>
  </div>
  <div class:list={['screen', { wide }]} set:html={render(lines)} />
</figure>
