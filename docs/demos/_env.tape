Set Shell "zsh"
Set FontSize 16
Set Width 1400
Set Height 820
Set Padding 24
Set Theme { "name": "wtm", "background": "#14121B", "foreground": "#E4E0EE", "cursor": "#E8734A", "selection": "#2A2638", "black": "#14121B", "red": "#FA6E76", "green": "#4ADE80", "yellow": "#F0C000", "blue": "#9B8CFF", "magenta": "#E8734A", "cyan": "#5FD4C0", "white": "#E4E0EE", "brightBlack": "#6F6987", "brightRed": "#FA6E76", "brightGreen": "#4ADE80", "brightYellow": "#F0C000", "brightBlue": "#9B8CFF", "brightMagenta": "#E8734A", "brightCyan": "#5FD4C0", "brightWhite": "#F4F1FA" }
Set TypingSpeed 95ms
Set CursorBlink false
