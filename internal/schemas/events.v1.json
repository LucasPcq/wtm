{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LucasPcq/wtm/schemas/events.v1.json",
  "title": "wtm events v1",
  "description": "One line of `wtm events --output json`. Consumers ignore unknown fields and unknown types; `v` changes only on a breaking change.",
  "type": "object",
  "required": ["v", "type", "ts"],
  "properties": {
    "v": { "const": 1 },
    "type": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string", "maxLength": 256, "description": "WTM_CORRELATION_ID of the command that published the event, verbatim; absent when it had none." }
  },
  "$defs": {
    "repo": {
      "type": "object",
      "required": ["root", "common_dir"],
      "properties": {
        "root": { "type": "string", "minLength": 1, "description": "The main checkout." },
        "common_dir": { "type": "string", "minLength": 1, "description": "git rev-parse --git-common-dir, absolute: the repository's key." }
      }
    },
    "worktree": {
      "type": "object",
      "required": ["branch", "path", "parent", "ordinal", "isolation", "is_main", "created_at"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "parent": { "type": "string", "description": "The branch it was created from; empty for the main checkout." },
        "ordinal": { "type": ["integer", "null"], "minimum": 0, "description": "Null until the worktree is first given one." },
        "isolation": { "type": "string" },
        "is_main": { "type": "boolean" },
        "created_at": { "type": "string" }
      }
    },
    "snapshotWorktree": {
      "allOf": [{ "$ref": "#/$defs/worktree" }],
      "properties": {
        "jobs": {
          "type": ["array", "null"],
          "description": "The worktree's jobs as they are now; null when the daemon could not be asked. A shared service is listed under the worktree it runs in.",
          "items": {
            "type": "object",
            "required": ["name", "kind", "state"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "kind": { "$ref": "#/$defs/jobKind" },
              "state": { "enum": ["starting", "running", "crashed", "stopped"] },
              "url": { "type": "string" },
              "exit_code": { "type": "integer", "description": "On a crashed job only." }
            }
          }
        }
      }
    },
    "jobKind": { "enum": ["service", "task"] },
    "jobWorktree": {
      "type": "object",
      "required": ["branch", "path"],
      "description": "Names the worktree the job runs in; it does not describe it, so never upsert an identity from it.",
      "properties": {
        "branch": { "type": "string" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "job": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/jobKind" },
        "url": { "type": "string", "minLength": 1, "description": "Where the job answers; absent for one that publishes no address." }
      }
    },
    "hookOk": { "type": "boolean", "description": "Whether every hook of the phase passed; true when there were none." },
    "hookCmd": { "type": "string", "minLength": 1, "description": "The failing hook's command; only when ok is false, and absent when the phase failed before any hook ran." },
    "hookExitCode": { "type": "integer", "minimum": 0, "description": "The failing hook's exit status; absent when it was killed by a signal." },
    "changed": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["isolation", "ordinal", "parent", "created_at"] }
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": { "const": "snapshot" },
        "repo": { "$ref": "#/$defs/repo" },
        "worktrees": { "type": "array", "items": { "$ref": "#/$defs/snapshotWorktree" } }
      },
      "required": ["repo", "worktrees"]
    },
    {
      "properties": { "type": { "const": "ready" } }
    },
    {
      "properties": {
        "type": { "const": "worktree.created" },
        "repo": { "$ref": "#/$defs/repo" },
        "worktree": { "$ref": "#/$defs/worktree" }
      },
      "required": ["repo", "worktree"]
    },
    {
      "properties": {
        "type": { "const": "worktree.provisioned" },
        "repo": { "$ref": "#/$defs/repo" },
        "worktree": { "$ref": "#/$defs/worktree" },
        "ok": { "$ref": "#/$defs/hookOk" },
        "hook": { "$ref": "#/$defs/hookCmd" },
        "exit_code": { "$ref": "#/$defs/hookExitCode" }
      },
      "required": ["repo", "worktree", "ok"]
    },
    {
      "properties": {
        "type": { "const": "worktree.updated" },
        "repo": { "$ref": "#/$defs/repo" },
        "worktree": { "$ref": "#/$defs/worktree" },
        "changed": { "$ref": "#/$defs/changed" }
      },
      "required": ["repo", "worktree", "changed"]
    },
    {
      "properties": {
        "type": { "const": "worktree.relocated" },
        "repo": { "$ref": "#/$defs/repo" },
        "worktree": { "$ref": "#/$defs/worktree" },
        "from_path": { "type": "string", "minLength": 1 }
      },
      "required": ["repo", "worktree", "from_path"]
    },
    {
      "properties": {
        "type": { "const": "worktree.reparented" },
        "repo": { "$ref": "#/$defs/repo" },
        "worktree": { "$ref": "#/$defs/worktree" },
        "from_parent": { "type": "string" }
      },
      "required": ["repo", "worktree"]
    },
    {
      "properties": {
        "type": { "const": "worktree.deprovisioned" },
        "repo": { "$ref": "#/$defs/repo" },
        "worktree": { "$ref": "#/$defs/worktree" },
        "ok": { "$ref": "#/$defs/hookOk" },
        "hook": { "$ref": "#/$defs/hookCmd" },
        "exit_code": { "$ref": "#/$defs/hookExitCode" }
      },
      "required": ["repo", "worktree", "ok"]
    },
    {
      "properties": {
        "type": { "const": "worktree.removed" },
        "repo": { "$ref": "#/$defs/repo" },
        "worktree": { "$ref": "#/$defs/worktree" }
      },
      "required": ["repo", "worktree"]
    },
    {
      "properties": {
        "type": { "const": "repo.added" },
        "repo": { "$ref": "#/$defs/repo" }
      },
      "required": ["repo"]
    },
    {
      "properties": {
        "type": { "const": "repo.removed" },
        "repo": { "$ref": "#/$defs/repo" }
      },
      "required": ["repo"]
    },
    {
      "properties": {
        "type": { "enum": ["job.started", "job.exited", "job.stopped"] },
        "repo": { "$ref": "#/$defs/repo" },
        "worktree": { "$ref": "#/$defs/jobWorktree" },
        "job": { "$ref": "#/$defs/job" },
        "exit_code": { "const": 0, "description": "On job.exited only." }
      },
      "required": ["repo", "worktree", "job"]
    },
    {
      "properties": {
        "type": { "const": "job.crashed" },
        "repo": { "$ref": "#/$defs/repo" },
        "worktree": { "$ref": "#/$defs/jobWorktree" },
        "job": { "$ref": "#/$defs/job" },
        "exit_code": { "type": "integer", "description": "What the process exited with; -1 when a signal killed it." },
        "last_lines": { "type": "array", "items": { "type": "string" }, "description": "The last lines it wrote, terminal escapes removed; absent when it wrote none." }
      },
      "required": ["repo", "worktree", "job", "exit_code"]
    }
  ]
}
