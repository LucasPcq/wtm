#:schema ./schemas/run.schema.json

[[job]]
  name = "dev"
  kind = "service"
  cmd = "npm run dev"
  cwd = "."
  [job.ports]
    PORT = 3000
  [job.url]
    port = "PORT"

[[profile]]
  name = "all"
  jobs = ["dev"]
  default = true

[[env_port]]
  file = ".env"
  key = "PORT"
  job = "dev"
  port = "PORT"

[[env_port]]
  file = ".env"
  key = "NEXT_PUBLIC_URL"
  job = "dev"
  port = "PORT"

