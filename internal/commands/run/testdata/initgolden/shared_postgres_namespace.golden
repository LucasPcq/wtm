### stderr

### file .git/wtm/run.toml
#:schema ./schemas/run.schema.json

[[job]]
  name = "postgres"
  kind = "service"
  cmd = "docker compose -f docker-compose.yml up postgres"
  scope = "shared"
  [job.namespace]
    name = "app_{worktree}"
    create = "createdb -h localhost -p $DB_PORT $WTM_NAMESPACE"
    remove = "dropdb -h localhost -p $DB_PORT $WTM_NAMESPACE"

[[job]]
  name = "dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "."
  [job.ports]
    PORT = 4000
  [job.url]
    port = "PORT"

[[profile]]
  name = "all"
  jobs = ["postgres", "dev"]
  default = true

[[env_port]]
  file = ".env"
  key = "PORT"
  job = "dev"
  port = "PORT"

### file docker-compose.yml
services:
  postgres:
    image: postgres:16-alpine
    container_name: "${COMPOSE_PROJECT_NAME:-001}-app-postgres"
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
  cache:
    image: redis:7-alpine
    ports:
      - "6379:6379"
volumes:
  pgdata:
    name: "${COMPOSE_PROJECT_NAME:-001}-app-pgdata"

