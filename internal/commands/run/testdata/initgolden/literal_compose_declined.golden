### file .git/wtm/run.toml
#:schema ./schemas/run.schema.json

[[job]]
  name = "docker-compose"
  kind = "service"
  cmd = "docker-compose -f docker-compose.yml up -d"
  stop = "docker-compose -f docker-compose.yml down --remove-orphans"
  cwd = "."

[[job]]
  name = "dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "."
  [job.ports]
    DB_PORT = 5432
    PORT = 4000
  [job.url]
    port = "PORT"

[[profile]]
  name = "all"
  jobs = ["docker-compose", "dev"]
  default = true

