### file .git/wtm/run.toml
#:schema ./schemas/run.schema.json

addressing = "names"
concurrency = "parallel"

[[job]]
  name = "shop-api-dev"
  kind = "service"
  cmd = "pnpm --filter @shop/api exec tsx watch src/index.ts --port ${PORT}"
  cwd = "apps/shop/api"
  [job.ports]
    PORT = 4101
  [job.url]
    port = "PORT"

[[job]]
  name = "tunnel"
  kind = "service"
  cmd = "cloudflared tunnel run"

[[job]]
  name = "docker-compose"
  kind = "service"
  cmd = "docker-compose -f docker-compose.yml up -d"
  stop = "docker-compose -f docker-compose.yml down --remove-orphans"
  cwd = "."
  [job.ports]
    ADMINER_PORT = 8080
    MAILPIT_SMTP_PORT = 1025
    MAILPIT_UI_PORT = 8025
    MINIO_CONSOLE_PORT = 9001
    MINIO_PORT = 9000
    POSTGRES_PORT = 5432
    REDIS_PORT = 6379

[[job]]
  name = "dev:crm"
  kind = "service"
  cmd = "pnpm run dev:crm"
  cwd = "."

[[job]]
  name = "dev:shop"
  kind = "service"
  cmd = "pnpm run dev:shop"
  cwd = "."

[[job]]
  name = "crm-admin-dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "apps/crm/admin"
  [job.ports]
    VITE_PORT = 5176
  [job.url]
    port = "VITE_PORT"

[[job]]
  name = "crm-api-dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "apps/crm/api"
  [job.ports]
    PORT = 4002
  [job.url]
    port = "PORT"

[[job]]
  name = "crm-web-dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "apps/crm/web"
  [job.ports]
    VITE_PORT = 5175
  [job.url]
    port = "VITE_PORT"

[[job]]
  name = "shop-admin-dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "apps/shop/admin"
  [job.ports]
    VITE_PORT = 5174
  [job.url]
    port = "VITE_PORT"

[[job]]
  name = "shop-web-dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "apps/shop/web"
  [job.ports]
    VITE_PORT = 5173
  [job.url]
    port = "VITE_PORT"

[[profile]]
  name = "shop"
  jobs = ["shop-api-dev", "tunnel"]
  default = true

[[env_port]]
  file = ".env"
  key = "POSTGRES_PORT"
  job = "docker-compose"
  port = "POSTGRES_PORT"

[[env_port]]
  file = ".env"
  key = "REDIS_PORT"
  job = "docker-compose"
  port = "REDIS_PORT"

