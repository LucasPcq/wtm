### file .git/wtm/run.toml
#:schema ./schemas/run.schema.json

[[job]]
  name = "docker-compose"
  kind = "service"
  cmd = "docker-compose -f docker-compose.yml up -d"
  stop = "docker-compose -f docker-compose.yml down --remove-orphans"
  cwd = "."
  [job.ports]
    ADMINER_PORT = 8080
    MAILPIT_SMTP_PORT = 1025
    MAILPIT_UI_PORT = 8025
    MINIO_CONSOLE_PORT = 9001
    MINIO_PORT = 9000
    POSTGRES_PORT = 5432
    REDIS_PORT = 6379

[[job]]
  name = "dev:crm"
  kind = "service"
  cmd = "pnpm run dev:crm"
  cwd = "."

[[job]]
  name = "dev:shop"
  kind = "service"
  cmd = "pnpm run dev:shop"
  cwd = "."

[[job]]
  name = "crm-admin-dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "apps/crm/admin"
  [job.ports]
    VITE_PORT = 5176
  [job.url]
    port = "VITE_PORT"

[[job]]
  name = "crm-api-dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "apps/crm/api"
  [job.ports]
    PORT = 4002
  [job.url]
    port = "PORT"

[[job]]
  name = "crm-web-dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "apps/crm/web"
  [job.ports]
    VITE_PORT = 5175
  [job.url]
    port = "VITE_PORT"

[[job]]
  name = "shop-admin-dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "apps/shop/admin"
  [job.ports]
    VITE_PORT = 5174
  [job.url]
    port = "VITE_PORT"

[[job]]
  name = "shop-api-dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "apps/shop/api"
  [job.ports]
    PORT = 4001
  [job.url]
    port = "PORT"

[[job]]
  name = "shop-web-dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "apps/shop/web"
  [job.ports]
    VITE_PORT = 5173
  [job.url]
    port = "VITE_PORT"

[[profile]]
  name = "crm-admin"
  jobs = ["docker-compose", "crm-admin-dev"]
  default = false

[[profile]]
  name = "crm-api"
  jobs = ["docker-compose", "crm-api-dev"]
  default = false

[[profile]]
  name = "crm-web"
  jobs = ["docker-compose", "crm-web-dev"]
  default = false

[[profile]]
  name = "shop-admin"
  jobs = ["docker-compose", "shop-admin-dev"]
  default = false

[[profile]]
  name = "shop-api"
  jobs = ["docker-compose", "shop-api-dev"]
  default = false

[[profile]]
  name = "shop-web"
  jobs = ["docker-compose", "shop-web-dev"]
  default = false

[[profile]]
  name = "dev:crm"
  jobs = ["docker-compose", "dev:crm"]
  default = false

[[profile]]
  name = "dev:shop"
  jobs = ["docker-compose", "dev:shop"]
  default = false

[[profile]]
  name = "all"
  jobs = ["docker-compose", "crm-admin-dev", "crm-api-dev", "crm-web-dev", "shop-admin-dev", "shop-api-dev", "shop-web-dev"]
  default = true

[[env_port]]
  file = ".env"
  key = "POSTGRES_PORT"
  job = "docker-compose"
  port = "POSTGRES_PORT"

