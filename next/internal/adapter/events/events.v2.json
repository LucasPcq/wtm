{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wtm.sh/schemas/events.v2.json",
  "title": "wtm events v2",
  "description": "One line of `wtm events --output json`, as every wtm process publishes it on the event bus. Consumers ignore unknown fields and unknown types: a type this schema does not list is valid against the envelope alone. `v` changes only on a breaking change.",
  "type": "object",
  "required": ["v", "type", "ts"],
  "properties": {
    "v": { "const": 2 },
    "type": { "type": "string", "minLength": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "repo": { "$ref": "#/$defs/repo" },
    "correlation_id": { "type": "string", "maxLength": 256, "description": "WTM_CORRELATION_ID of the command that published the event, verbatim; absent when it had none." },
    "op_id": { "type": "string", "minLength": 1, "description": "The operation the event belongs to; absent outside an operation." }
  },
  "$defs": {
    "surface": {
      "description": "Where an operation was started from: the command line, a command's wizard, the web front, or a call of the catalogue that names none.",
      "enum": ["cli", "tui", "web", "api"]
    },
    "phase": {
      "description": "A phase of a subject's work, as phase.started and phase.finished name it: a closed set a surface names one by one.",
      "enum": ["fast_forward", "worktree", "env", "meta", "ordinal", "ports", "on_create", "move", "on_clean", "remove", "exec"]
    },
    "repo": {
      "type": "object",
      "required": ["root", "common_dir"],
      "properties": {
        "root": { "type": "string", "minLength": 1, "description": "The main worktree." },
        "common_dir": { "type": "string", "minLength": 1, "description": "git rev-parse --git-common-dir, absolute, symbolic links resolved: the repository's key." }
      }
    },
    "worktree": {
      "type": "object",
      "required": ["branch", "path", "parent", "ordinal", "isolation", "is_main", "created_at"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "parent": { "type": "string", "description": "The branch it was created from; empty for the main worktree and one wtm did not create." },
        "ordinal": { "type": ["integer", "null"], "minimum": 0, "description": "0 for the main worktree; null until the worktree is first given one." },
        "isolation": { "type": "string" },
        "is_main": { "type": "boolean" },
        "created_at": { "type": "string" }
      }
    },
    "unit.started": {
      "description": "The work on one subject of an operation begins.",
      "type": "object",
      "required": ["type", "subject"],
      "properties": { "type": { "const": "unit.started" }, "subject": { "type": "string", "minLength": 1, "description": "What the unit works on: a branch." } }
    },
    "phase.started": {
      "description": "A phase of a subject's work begins.",
      "type": "object",
      "required": ["type", "subject", "phase"],
      "properties": {
        "type": { "const": "phase.started" },
        "subject": { "type": "string", "minLength": 1, "description": "What the unit works on: a branch." },
        "phase": { "$ref": "#/$defs/phase" },
        "log": { "type": "string", "minLength": 1, "description": "The file the phase's output goes to; absent when it has none." }
      }
    },
    "phase.finished": {
      "description": "A phase of a subject's work ended.",
      "type": "object",
      "required": ["type", "subject", "phase", "failed"],
      "properties": {
        "type": { "const": "phase.finished" },
        "subject": { "type": "string", "minLength": 1, "description": "What the unit works on: a branch." },
        "phase": { "$ref": "#/$defs/phase" },
        "failed": { "type": "boolean" }
      }
    },
    "phase.output": {
      "description": "One line a phase printed: a hook's output.",
      "type": "object",
      "required": ["type", "subject", "line"],
      "properties": { "type": { "const": "phase.output" }, "subject": { "type": "string", "minLength": 1, "description": "What the unit works on: a branch." }, "line": { "type": "string" } }
    },
    "unit.finished": {
      "description": "The work on one subject of an operation ended.",
      "type": "object",
      "required": ["type", "subject", "status"],
      "properties": {
        "type": { "const": "unit.finished" },
        "subject": { "type": "string", "minLength": 1, "description": "What the unit works on: a branch." },
        "status": { "enum": ["done", "failed", "skipped", "cancelled"] }
      }
    },
    "worktree.created": {
      "description": "A worktree was added.",
      "type": "object",
      "required": ["type", "worktree"],
      "properties": { "type": { "const": "worktree.created" }, "worktree": { "$ref": "#/$defs/worktree" } }
    },
    "worktree.updated": {
      "description": "Fields of a worktree's identity changed, changed naming them.",
      "type": "object",
      "required": ["type", "worktree", "changed"],
      "properties": {
        "type": { "const": "worktree.updated" },
        "worktree": { "$ref": "#/$defs/worktree" },
        "changed": { "type": "array", "minItems": 1, "items": { "enum": ["isolation", "ordinal", "parent", "created_at"] } }
      }
    },
    "worktree.changed": {
      "description": "What a worktree holds changed with no operation of wtm, as the stream polls it, changed naming what; never published on the bus. A worktree the stream had not seen yet is one, every field changed.",
      "type": "object",
      "required": ["type", "worktree", "changed"],
      "properties": {
        "type": { "const": "worktree.changed" },
        "worktree": { "$ref": "#/$defs/worktree" },
        "changed": { "type": "array", "minItems": 1, "items": { "enum": ["head", "checkout", "jobs", "dirty"] } }
      }
    },
    "worktree.provisioned": {
      "description": "A worktree's provisioning ended.",
      "type": "object",
      "required": ["type", "worktree", "ok"],
      "properties": {
        "type": { "const": "worktree.provisioned" },
        "worktree": { "$ref": "#/$defs/worktree" },
        "ok": { "type": "boolean", "description": "Whether every hook passed; true when there were none." },
        "hook": { "type": "string", "minLength": 1, "description": "The failing hook's command; only when ok is false, and absent when provisioning failed before any hook ran." },
        "exit_code": { "type": "integer", "minimum": 0, "description": "The failing hook's exit status; absent when it was killed by a signal." }
      }
    },
    "worktree.removed": {
      "description": "A worktree was removed, with its branch and its meta record; a worktree on no branch has neither.",
      "type": "object",
      "required": ["type", "worktree"],
      "properties": { "type": { "const": "worktree.removed" }, "worktree": { "$ref": "#/$defs/worktree" } }
    },
    "operation.started": {
      "description": "An operation began.",
      "type": "object",
      "required": ["type", "command", "surface"],
      "properties": {
        "type": { "const": "operation.started" },
        "command": { "type": "string", "minLength": 1, "description": "The command, as its command line spells it after the program's name." },
        "surface": { "$ref": "#/$defs/surface" }
      }
    },
    "operation.finished": {
      "description": "An operation ended.",
      "type": "object",
      "required": ["type", "command", "surface", "ok"],
      "properties": {
        "type": { "const": "operation.finished" },
        "command": { "type": "string", "minLength": 1, "description": "The command, as its command line spells it after the program's name." },
        "surface": { "$ref": "#/$defs/surface" },
        "ok": { "type": "boolean" },
        "code": { "type": "string", "minLength": 1, "description": "The code of the failure the operation ended on; absent when ok." }
      }
    },
    "snapshot": {
      "description": "Every worktree of a repository on a branch, as the stream opens on it.",
      "type": "object",
      "required": ["type", "worktrees"],
      "properties": {
        "type": { "const": "snapshot" },
        "worktrees": { "type": "array", "items": { "$ref": "#/$defs/worktree" }, "description": "Every worktree on a branch: a reset of what the reader knows of the repository." }
      }
    },
    "ready": { "description": "The stream sent its snapshots: every event after it is a change.", "type": "object", "required": ["type"], "properties": { "type": { "const": "ready" } } },
    "repo.added": { "description": "A repository joined those wtm knows.", "type": "object", "required": ["type"], "properties": { "type": { "const": "repo.added" } } },
    "repo.removed": { "description": "A repository left those wtm knows: it is gone, or no longer initialized.", "type": "object", "required": ["type"], "properties": { "type": { "const": "repo.removed" } } },
    "job_worktree": {
      "description": "The worktree a job runs in, as its client named it to the run daemon, which reads no more of it.",
      "type": "object",
      "required": ["branch", "path"],
      "properties": { "branch": { "type": "string" }, "path": { "type": "string", "minLength": 1 } }
    },
    "job": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["service", "task"] },
        "url": { "type": "string", "minLength": 1, "description": "Where the job answers; absent when it publishes none." },
        "detached": { "type": "boolean", "description": "A stack its launcher left running (a service with a stop command), no process of the daemon's." }
      }
    },
    "job.started": {
      "description": "The run daemon started a job: a foreground service is up, a detached launcher left its stack running, a task began. Published by the daemon itself.",
      "type": "object",
      "required": ["type", "worktree", "job"],
      "properties": { "type": { "const": "job.started" }, "worktree": { "$ref": "#/$defs/job_worktree" }, "job": { "$ref": "#/$defs/job" } }
    },
    "job.stopped": {
      "description": "A job stopped because a client asked. Published by the run daemon itself.",
      "type": "object",
      "required": ["type", "worktree", "job"],
      "properties": { "type": { "const": "job.stopped" }, "worktree": { "$ref": "#/$defs/job_worktree" }, "job": { "$ref": "#/$defs/job" } }
    },
    "job.crashed": {
      "description": "A service ended on its own, or a task failed. Published by the run daemon itself.",
      "type": "object",
      "required": ["type", "worktree", "job"],
      "properties": {
        "type": { "const": "job.crashed" },
        "worktree": { "$ref": "#/$defs/job_worktree" },
        "job": { "$ref": "#/$defs/job" },
        "exit_code": { "type": "integer", "minimum": -1, "description": "Its exit status, -1 when a signal killed it." },
        "last_lines": { "type": "array", "items": { "type": "string" }, "description": "The last lines it printed, oldest first." }
      }
    },
    "job.exited": {
      "description": "A task ran to its end, exit code 0. Published by the run daemon itself.",
      "type": "object",
      "required": ["type", "worktree", "job"],
      "properties": {
        "type": { "const": "job.exited" },
        "worktree": { "$ref": "#/$defs/job_worktree" },
        "job": { "$ref": "#/$defs/job" },
        "exit_code": { "const": 0 }
      }
    },
    "event": {
      "description": "One event of every type this schema lists, its type first: what an operation reports as it runs, without the line the stream stamps on it.",
      "oneOf": [
        { "$ref": "#/$defs/unit.started" },
        { "$ref": "#/$defs/phase.started" },
        { "$ref": "#/$defs/phase.finished" },
        { "$ref": "#/$defs/phase.output" },
        { "$ref": "#/$defs/unit.finished" },
        { "$ref": "#/$defs/worktree.created" },
        { "$ref": "#/$defs/worktree.updated" },
        { "$ref": "#/$defs/worktree.changed" },
        { "$ref": "#/$defs/worktree.provisioned" },
        { "$ref": "#/$defs/worktree.removed" },
        { "$ref": "#/$defs/operation.started" },
        { "$ref": "#/$defs/operation.finished" },
        { "$ref": "#/$defs/snapshot" },
        { "$ref": "#/$defs/ready" },
        { "$ref": "#/$defs/repo.added" },
        { "$ref": "#/$defs/repo.removed" },
        { "$ref": "#/$defs/job.started" },
        { "$ref": "#/$defs/job.stopped" },
        { "$ref": "#/$defs/job.crashed" },
        { "$ref": "#/$defs/job.exited" }
      ]
    }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "unit.started" } } }, "then": { "$ref": "#/$defs/unit.started" } },
    { "if": { "properties": { "type": { "const": "phase.started" } } }, "then": { "$ref": "#/$defs/phase.started" } },
    { "if": { "properties": { "type": { "const": "phase.finished" } } }, "then": { "$ref": "#/$defs/phase.finished" } },
    { "if": { "properties": { "type": { "const": "phase.output" } } }, "then": { "$ref": "#/$defs/phase.output" } },
    { "if": { "properties": { "type": { "const": "unit.finished" } } }, "then": { "$ref": "#/$defs/unit.finished", "required": ["repo", "op_id"] } },
    { "if": { "properties": { "type": { "const": "worktree.created" } } }, "then": { "$ref": "#/$defs/worktree.created", "required": ["repo"] } },
    { "if": { "properties": { "type": { "const": "worktree.updated" } } }, "then": { "$ref": "#/$defs/worktree.updated", "required": ["repo"] } },
    { "if": { "properties": { "type": { "const": "worktree.changed" } } }, "then": { "$ref": "#/$defs/worktree.changed", "required": ["repo"] } },
    { "if": { "properties": { "type": { "const": "worktree.provisioned" } } }, "then": { "$ref": "#/$defs/worktree.provisioned", "required": ["repo"] } },
    { "if": { "properties": { "type": { "const": "worktree.removed" } } }, "then": { "$ref": "#/$defs/worktree.removed", "required": ["repo"] } },
    { "if": { "properties": { "type": { "const": "operation.started" } } }, "then": { "$ref": "#/$defs/operation.started", "required": ["repo", "op_id"] } },
    { "if": { "properties": { "type": { "const": "operation.finished" } } }, "then": { "$ref": "#/$defs/operation.finished", "required": ["repo", "op_id"] } },
    { "if": { "properties": { "type": { "const": "snapshot" } } }, "then": { "$ref": "#/$defs/snapshot", "required": ["repo"] } },
    { "if": { "properties": { "type": { "const": "ready" } } }, "then": { "$ref": "#/$defs/ready", "not": { "required": ["repo"] } } },
    { "if": { "properties": { "type": { "const": "repo.added" } } }, "then": { "$ref": "#/$defs/repo.added", "required": ["repo"] } },
    { "if": { "properties": { "type": { "const": "repo.removed" } } }, "then": { "$ref": "#/$defs/repo.removed", "required": ["repo"] } },
    { "if": { "properties": { "type": { "const": "job.started" } } }, "then": { "$ref": "#/$defs/job.started", "required": ["repo"] } },
    { "if": { "properties": { "type": { "const": "job.stopped" } } }, "then": { "$ref": "#/$defs/job.stopped", "required": ["repo"] } },
    { "if": { "properties": { "type": { "const": "job.crashed" } } }, "then": { "$ref": "#/$defs/job.crashed", "required": ["repo"] } },
    { "if": { "properties": { "type": { "const": "job.exited" } } }, "then": { "$ref": "#/$defs/job.exited", "required": ["repo"] } }
  ]
}
