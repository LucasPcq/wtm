## run.toml
#:schema ./schemas/run.schema.json

[[job]]
  name = "docker-compose"
  kind = "service"
  cmd = "docker-compose -f docker-compose.yml up -d"
  stop = "docker-compose -f docker-compose.yml down --remove-orphans"
  cwd = "."
  [job.ports]
    MAILPIT_PORT = 8025
    POSTGRES_PORT = 5432
    REDIS_PORT = 6379

[[job]]
  name = "admin-dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "apps/admin"

[[job]]
  name = "api-dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "apps/api"
  [job.ports]
    PORT = 4000
  [job.url]
    port = "PORT"

[[job]]
  name = "web-dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "apps/web"
  [job.ports]
    PORT = 3000
  [job.url]
    port = "PORT"

[[job]]
  name = "worker-dev"
  kind = "service"
  cmd = "pnpm run dev"
  cwd = "apps/worker"

[[profile]]
  name = "admin"
  jobs = ["docker-compose", "admin-dev"]
  default = false

[[profile]]
  name = "api"
  jobs = ["docker-compose", "api-dev"]
  default = false

[[profile]]
  name = "web"
  jobs = ["docker-compose", "web-dev"]
  default = false

[[profile]]
  name = "worker"
  jobs = ["docker-compose", "worker-dev"]
  default = false

[[profile]]
  name = "all"
  jobs = ["docker-compose", "admin-dev", "api-dev", "web-dev", "worker-dev"]
  default = true

[[env_port]]
  file = "apps/admin/.env"
  key = "NEXT_PUBLIC_API_URL"
  job = "api-dev"
  port = "PORT"

[[env_port]]
  file = "apps/api/.env"
  key = "PORT"
  job = "api-dev"
  port = "PORT"

[[env_port]]
  file = "apps/api/.env"
  key = "DATABASE_URL"
  job = "docker-compose"
  port = "POSTGRES_PORT"

[[env_port]]
  file = "apps/api/.env"
  key = "REDIS_URL"
  job = "docker-compose"
  port = "REDIS_PORT"

[[env_port]]
  file = "apps/web/.env.local"
  key = "PORT"
  job = "web-dev"
  port = "PORT"

[[env_port]]
  file = "apps/web/.env.local"
  key = "NEXT_PUBLIC_API_URL"
  job = "api-dev"
  port = "PORT"

[[env_port]]
  file = "apps/worker/.env"
  key = "REDIS_URL"
  job = "docker-compose"
  port = "REDIS_PORT"

[[env_port]]
  file = "packages/db/.env"
  key = "DATABASE_URL"
  job = "docker-compose"
  port = "POSTGRES_PORT"
## docker-compose.yml
services:
  postgres:
    image: postgres:16
    environment:
      POSTGRES_PASSWORD: postgres
    ports:
      - "${POSTGRES_PORT:-5432}:5432"
  redis:
    image: redis:7
    ports:
      - "${REDIS_PORT:-6379}:6379"
  mailpit:
    image: axllent/mailpit
    ports:
      - "${MAILPIT_PORT:-8025}:8025"
      - "1025:1025"
## config.toml, its .env files
strategy = "example"
target = "apps/admin/.env"
template = "apps/admin/.env.example"
target = "apps/api/.env"
template = "apps/api/.env.example"
target = "apps/web/.env.local"
local = true
target = "apps/worker/.env"
template = "apps/worker/.env.example"
target = "packages/db/.env"
template = "packages/db/.env.example"
## git status
 M docker-compose.yml
