## run.toml
#:schema ./schemas/run.schema.json

addressing = "names"

[[job]]
  name = "postgres"
  kind = "service"
  cmd = "docker compose up -d postgres"
  stop = "docker compose stop postgres"
  binds_no_port = true
  scope = "shared"
  [job.namespace]
    name = "acme_{worktree}"
    create = "docker compose exec -T postgres createdb -U postgres \"$WTM_NAMESPACE\""
    remove = "docker compose exec -T postgres dropdb -U postgres --if-exists \"$WTM_NAMESPACE\""

[[job]]
  name = "redis"
  kind = "service"
  cmd = "docker compose up -d redis"
  stop = "docker compose stop redis"
  binds_no_port = true

[[job]]
  name = "mailpit"
  kind = "service"
  cmd = "docker compose up -d mailpit"
  stop = "docker compose stop mailpit"
  binds_no_port = true
  scope = "shared"

[[job]]
  name = "admin"
  kind = "service"
  cmd = "pnpm dev"
  cwd = "apps/admin"
  [job.ports]
    ADMIN_PORT = 3001
  [job.url]
    port = "ADMIN_PORT"

[[job]]
  name = "api"
  kind = "service"
  cmd = "pnpm dev"
  cwd = "apps/api"
  [job.ports]
    PORT = 4000
  [job.url]
    port = "PORT"

[[job]]
  name = "web"
  kind = "service"
  cmd = "pnpm dev"
  cwd = "apps/web"
  [job.ports]
    PORT = 3000
  [job.url]
    port = "PORT"

[[job]]
  name = "worker"
  kind = "service"
  cmd = "pnpm dev"
  cwd = "apps/worker"
  binds_no_port = true

[[job]]
  name = "migrate"
  kind = "task"
  cmd = "pnpm migrate"
  cwd = "packages/db"
  touches = ["postgres"]

[[job]]
  name = "seed"
  kind = "task"
  cmd = "pnpm seed"
  cwd = "packages/db"
  touches = ["postgres"]

[[profile]]
  name = "all"
  jobs = ["postgres", "redis", "mailpit", "admin", "api", "web", "worker", "migrate", "seed"]
  default = true

[[profile]]
  name = "admin"
  jobs = ["api", "admin"]
  default = false

[[profile]]
  name = "api"
  jobs = ["api"]
  default = false

[[profile]]
  name = "web"
  jobs = ["api", "web"]
  default = false

[[profile]]
  name = "worker"
  jobs = ["worker"]
  default = false

[[env_port]]
  file = "apps/admin/.env"
  key = "NEXT_PUBLIC_API_URL"
  job = "api"
  port = "PORT"

[[env_port]]
  file = "apps/api/.env"
  key = "PORT"
  job = "api"
  port = "PORT"

[[env_port]]
  file = "apps/web/.env.local"
  key = "PORT"
  job = "web"
  port = "PORT"

[[env_port]]
  file = "apps/web/.env.local"
  key = "NEXT_PUBLIC_API_URL"
  job = "api"
  port = "PORT"
## docker-compose.yml
services:
  postgres:
    image: postgres:16
    environment:
      POSTGRES_PASSWORD: postgres
    ports:
      - "5432:5432"
  redis:
    image: redis:7
    ports:
      - "6379:6379"
  mailpit:
    image: axllent/mailpit
    ports:
      - "8025:8025"
      - "1025:1025"
## config.toml, its .env files
strategy = "example"
target = "apps/admin/.env"
template = "apps/admin/.env.example"
target = "apps/api/.env"
template = "apps/api/.env.example"
target = "apps/web/.env.local"
local = true
target = "apps/worker/.env"
template = "apps/worker/.env.example"
target = "packages/db/.env"
template = "packages/db/.env.example"
## git status
