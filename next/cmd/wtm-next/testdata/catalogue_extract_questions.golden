{
  "fields": [
    {
      "kind": "select",
      "path": "source",
      "flag": "\u003csource\u003e",
      "label": "Source worktree",
      "help": "Which worktree to extract changes from",
      "value": "main",
      "options": [
        {
          "value": "main",
          "label": "",
          "badge": "1 change"
        }
      ],
      "rememberable": false,
      "remember": false,
      "refreshable": false
    },
    {
      "kind": "multi_select",
      "path": "files",
      "flag": "--files",
      "label": "Files",
      "help": "Files to extract, or a directory to take everything below it",
      "picked": [
        "notes.txt"
      ],
      "options": [
        {
          "value": "notes.txt",
          "label": "notes.txt",
          "badge": "new"
        }
      ],
      "empty": "Select at least one file"
    },
    {
      "kind": "select",
      "path": "to",
      "flag": "--to",
      "label": "Target worktree",
      "help": "Target worktree branch; created if it does not exist",
      "value": "feat/notes",
      "options": [
        {
          "value": "",
          "label": "+ Create a new worktree…",
          "short": "new worktree"
        }
      ],
      "rememberable": false,
      "remember": false,
      "refreshable": false
    },
    {
      "kind": "text",
      "path": "to",
      "flag": "--to",
      "label": "Branch name",
      "help": "Name for the new worktree branch",
      "value": "feat/notes"
    },
    {
      "kind": "select",
      "path": "from",
      "flag": "--from",
      "label": "Source branch",
      "help": "Parent branch when creating the target worktree",
      "origin": "config",
      "value": "main",
      "options": [
        {
          "value": "main",
          "label": "main (default)"
        }
      ],
      "pinned": "main",
      "rememberable": false,
      "remember": false,
      "refreshable": true
    },
    {
      "kind": "select",
      "path": "env_from",
      "flag": "--env-from",
      "label": "Env strategy",
      "help": "Where the new target's .env files come from: config, example, main or parent; config.toml's strategy by default",
      "origin": "default",
      "value": "config",
      "options": [
        {
          "value": "config",
          "label": "config default (example)",
          "short": "config default"
        },
        {
          "value": "example",
          "label": "example — from .env.example"
        },
        {
          "value": "main",
          "label": "main — the main checkout's .env"
        },
        {
          "value": "parent",
          "label": "parent — the source worktree's .env"
        }
      ],
      "rememberable": true,
      "remember": false,
      "refreshable": false
    },
    {
      "kind": "select",
      "path": "isolation",
      "flag": "--isolation",
      "label": "Isolation",
      "help": "How it stands against its source: isolated or verbatim; run.toml's isolation by default",
      "origin": "default",
      "skip": "run.toml declares nothing a worktree isolates",
      "value": "isolated",
      "options": [
        {
          "value": "isolated",
          "label": "isolated — its own ports and namespaces"
        },
        {
          "value": "verbatim",
          "label": "verbatim — the copied .env as is, one runs at a time"
        }
      ],
      "rememberable": true,
      "remember": false,
      "refreshable": false
    },
    {
      "kind": "confirm",
      "path": "fast_forward",
      "flag": "--ff",
      "label": "Source update",
      "help": "Fast-forward the source branch to origin first when it is behind",
      "skip": "nothing to fast-forward: the source is not behind origin",
      "value": false,
      "yes": {
        "value": "true",
        "label": "Fast-forward to origin",
        "short": "fast-forward to origin"
      },
      "no": {
        "value": "false",
        "label": "Keep it as-is",
        "short": "keep as-is"
      },
      "no_first": false,
      "rememberable": true,
      "remember": false
    },
    {
      "kind": "confirm",
      "path": "keep",
      "flag": "--keep",
      "label": "Mode",
      "help": "Copy instead of move (keep the changes in the source)",
      "origin": "default",
      "value": false,
      "yes": {
        "value": "true",
        "label": "Copy — keep the files in main",
        "short": "copy"
      },
      "no": {
        "value": "false",
        "label": "Move — remove the files from main",
        "short": "move"
      },
      "no_first": true,
      "rememberable": false,
      "remember": false
    },
    {
      "kind": "select",
      "path": "on_conflict",
      "flag": "--on-conflict",
      "label": "On conflict",
      "help": "On conflict: abort (default) or resolve (write conflict markers in the target)",
      "origin": "default",
      "skip": "nothing conflicts with the target",
      "value": "abort",
      "options": [
        {
          "value": "abort",
          "label": "Abort — leave both worktrees untouched"
        },
        {
          "value": "resolve",
          "label": "Resolve — write conflict markers in feat/notes"
        }
      ],
      "rememberable": false,
      "remember": false,
      "refreshable": false
    }
  ],
  "problems": []
}
