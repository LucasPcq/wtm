    {
      "kind": "select",
      "path": "env_from",
      "flag": "--env-from",
      "label": "Env strategy",
      "help": "How the .env files of the new worktrees are provisioned: config (config.toml's strategy), example (from its template), main (copied from the main checkout) or parent (from the source's worktree); defaults to config.toml's strategy",
      "value": "",
      "options": [
        {
          "value": "config",
          "label": "Use config default ()",
          "short": "config default"
        },
        {
          "value": "example",
          "label": "example — copy .env.example → .env"
        },
        {
          "value": "main",
          "label": "main — copy .env from the main checkout"
        },
        {
          "value": "parent",
          "label": "parent — copy .env from source worktree"
