language js

or {
  JsFunctionDeclaration(id=$id, parameters=$ps),
  JsFunctionExportDefaultDeclaration(id=$id, parameters=$ps),
  JsVariableDeclarator(id=$id, initializer=JsInitializerClause(expression=JsArrowFunctionExpression(parameters=$ps))),
  JsVariableDeclarator(id=$id, initializer=JsInitializerClause(expression=JsFunctionExpression(parameters=$ps))),
  JsVariableDeclarator(id=$id, initializer=JsInitializerClause(expression=JsCallExpression(arguments=JsCallArguments(args=[
    JsArrowFunctionExpression(parameters=$ps), ...
  ]))))
} where {
  $id <: r"[A-Z].*",
  $ps <: or {
    JsParameters(items=[JsFormalParameter(binding=JsIdentifierBinding() as $p), ...]),
    JsIdentifierBinding() as $p
  },
  register_diagnostic(span=$p, message="Destructure props in the parameters (web-front skill, props).")
}
