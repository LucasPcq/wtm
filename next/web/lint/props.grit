language js

or {
  JsFunctionDeclaration(id=$id, parameters=$ps) where { $id <: r"[A-Z].*" },
  JsFunctionExpression(id=$id, parameters=$ps) where { $id <: r"[A-Z].*" },
  JsFunctionExportDefaultDeclaration(id=$id, parameters=$ps) where { $id <: r"[A-Z].*" },
  JsFunctionExportDefaultDeclaration(id=., parameters=$ps),
  JsVariableDeclarator(id=$id, initializer=JsInitializerClause(expression=JsArrowFunctionExpression(parameters=$ps))) where {
    $id <: r"[A-Z].*"
  },
  JsVariableDeclarator(id=$id, initializer=JsInitializerClause(expression=JsFunctionExpression(parameters=$ps))) where {
    $id <: r"[A-Z].*"
  },
  JsVariableDeclarator(id=$id, initializer=JsInitializerClause(expression=JsCallExpression(arguments=JsCallArguments(args=[
    JsArrowFunctionExpression(parameters=$ps), ...
  ])))) where { $id <: r"[A-Z].*" }
} where {
  $ps <: or {
    JsParameters(items=[JsFormalParameter(binding=JsIdentifierBinding() as $p), ...]),
    JsIdentifierBinding() as $p
  },
  register_diagnostic(span=$p, message="Destructure props in the parameters (web-front skill, props).")
}
