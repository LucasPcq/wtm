language js

or {
  JsImport(),
  JsExport()
} as $item where {
  $filename <: r".*/src/(.*)"($rel),
  or {
    and {
      $rel <: r"([^/]+)/.*"($layer),
      not $layer <: or {
        "api",
        "lib",
        "routes",
        "components",
        "features",
        "test",
        "hooks"
      },
      $msg = "A file of src/ lives in a known layer, or is the entry (web-front skill, unknown-folder)."
    },
    and {
      $rel <: r"[^/]+",
      not $rel <: "main.tsx",
      $msg = "A file of src/ lives in a known layer, or is the entry (web-front skill, unknown-folder)."
    },
    and {
      $rel <: r".*\.test\.tsx?",
      not $rel <: r"(?:.*/)?__tests__/[^/]+\.test\.tsx?",
      $msg = "A test lives in the __tests__/ beside the code it tests (web-front skill, unknown-folder)."
    },
    and {
      $rel <: r"features/.*",
      not or {
        and { $rel <: r"features/[^/]+/[^/]+\.tsx", not $rel <: r".*\.test\.tsx" },
        and {
          $rel <: r"features/[^/]+/([^/]+)/[^/]+\.tsx"($sub),
          not $sub <: or {
            "components",
            "hooks",
            "utils",
            "store",
            "shared",
            "__tests__"
          },
          not $rel <: r".*\.test\.tsx"
        },
        and {
          $rel <: r"features/[^/]+/(?:components/[^/]+\.tsx|hooks/use-[^/]+\.ts|utils/[^/]+\.tsx?|store/[^/]+\.ts|(?:components|utils)/__tests__/[^/]+\.test\.tsx?)",
          not $rel <: r"features/[^/]+/[^/_]+/[^/]+\.test\.tsx?"
        },
        and {
          $rel <: r"features/[^/]+/([^/]+)/(?:components/[^/]+\.tsx|hooks/use-[^/]+\.ts|utils/[^/]+\.tsx?|(?:components|utils)/__tests__/[^/]+\.test\.tsx?)"($sub),
          not $sub <: or {
            "components",
            "hooks",
            "utils",
            "store",
            "shared",
            "__tests__"
          },
          not $rel <: r"features/[^/]+/[^/]+/[^/_]+/[^/]+\.test\.tsx?"
        }
      },
      $msg = "A feature or a sub-feature holds its entry .tsx, then components/ (.tsx), hooks/ (use-*.ts), utils/, store/ at the feature's root, and __tests__/ inside components/ or utils/ (web-front skill, unknown-folder)."
    }
  },
  register_diagnostic(span=$item, message=$msg)
}
