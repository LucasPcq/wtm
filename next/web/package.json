{
  "name": "wtm-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "types": "json2ts -i ../internal/api/api.v2.schema.json -o src/api/types.gen.ts --unreachableDefinitions --cwd ../internal/adapter/events",
    "predev": "npm run types",
    "dev": "vite",
    "prebuild": "npm run types && tsr generate",
    "build": "tsc -b && vite build && npm run lint",
    "lint": "biome check --error-on-warnings .",
    "test": "vitest run",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "eventsource-parser": "^4.1.2",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "json-schema-to-typescript": "^16.0.0",
    "msw": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
